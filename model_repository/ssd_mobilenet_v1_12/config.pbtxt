# Triton ONNX Runtime model configuration
# Source: ONNX Model Zoo SSD-MobileNetV1-12, upstream file SHA-256:
# b8fba5e404077d4048d27fcd1667e85e27e192eb9bf51e696c46a3acd7d21058
#
# Based on actual ONNX graph inspection with onnx==1.19.1 on 2026-11-04:
# IR v7, opset 12, onnx.checker.check_model PASSED.
# Unspecified/symbolic ONNX dimensions use -1.
# max_batch_size: 0 means the model's entire rank-4 [N,H,W,C] is declared in dims.
# Initial CPU-only functional test; dynamic batching is NOT enabled.

name: "ssd_mobilenet_v1_12"
backend: "onnxruntime"
max_batch_size: 0

input [
  {
    name: "inputs"
    data_type: TYPE_UINT8
    dims: [ -1, -1, -1, 3 ]
  }
]

output [
  {
    name: "detection_boxes"
    data_type: TYPE_FP32
    dims: [ -1, -1, 4 ]
  },
  {
    name: "detection_classes"
    data_type: TYPE_FP32
    dims: [ -1, -1 ]
  },
  {
    name: "detection_scores"
    data_type: TYPE_FP32
    dims: [ -1, -1 ]
  },
  {
    name: "num_detections"
    data_type: TYPE_FP32
    dims: [ -1 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]
